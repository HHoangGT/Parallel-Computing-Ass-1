set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release)
endif()

if(TSAN AND WIN32)
  message(FATAL_ERROR "ThreadSanitizer is not available on Windows")
endif()

if(NOT DEFINED CACHE_LINE)
  if(APPLE)
    execute_process(COMMAND sysctl -n hw.cachelinesize
                    OUTPUT_VARIABLE detected OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    execute_process(COMMAND getconf LEVEL1_DCACHE_LINESIZE
                    OUTPUT_VARIABLE detected OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  endif()
  if(NOT detected MATCHES "^[1-9][0-9]*$")
    set(detected 64)
  endif()
  set(CACHE_LINE ${detected} CACHE STRING "Cache line size in bytes")
endif()
message(STATUS "CACHE_LINE = ${CACHE_LINE}")

if(MSVC)
  add_compile_options(/W4)
else()
  add_compile_options(-Wall -Wextra)
  if(TSAN)
    set(CMAKE_CXX_FLAGS_RELEASE "-O1 -g")
    add_compile_options(-fsanitize=thread)
    add_link_options(-fsanitize=thread)
  else()
    set(CMAKE_CXX_FLAGS_RELEASE "-O2")
  endif()
endif()

if(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
  execute_process(COMMAND xcrun --show-sdk-path OUTPUT_VARIABLE sdk OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND xcrun -f clang OUTPUT_VARIABLE clang_bin OUTPUT_STRIP_TRAILING_WHITESPACE)
  get_filename_component(clang_dir "${clang_bin}" DIRECTORY)
  if(NOT EXISTS "${clang_dir}/../include/c++/v1/atomic")
    add_compile_options(-nostdinc++ -isystem "${sdk}/usr/include/c++/v1")
  endif()
endif()
